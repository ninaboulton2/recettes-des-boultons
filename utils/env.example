# Exemple de fichier .env.local pour le développement
# Copiez ce fichier vers .env.local et remplissez vos vraies valeurs

# Configuration Supabase pour le développement local
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_api_supabase

# Configuration de développement
NODE_ENV=development
API_BASE=http://localhost:3001

# Remplacez les valeurs ci-dessus par vos vraies informations Supabase
# Vous pouvez obtenir ces informations depuis votre projet Supabase :
# 1. Allez sur https://supabase.com
# 2. Connectez-vous à votre projet
# 3. Allez dans Settings > API
# 4. Copiez Project URL et anon public key
