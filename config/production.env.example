# Configuration de production pour l'authentification
# ⚠️ IMPORTANT: Changez toutes ces valeurs en production !

# Credentials admin (à changer absolument)
# Utilisez des mots de passe de 16+ caractères avec majuscules, minuscules, chiffres et symboles
ADMIN_USERNAME=votre-nouveau-username-admin-complexe
ADMIN_PASSWORD=VotreMotDePasseTresSecurise2024!@#$%^&*()

# Clé secrète JWT (générer une clé aléatoire de 64+ caractères)
# Commande pour générer: openssl rand -base64 64
JWT_SECRET=votre-cle-secrete-tres-longue-et-complexe-pour-la-production-2024-avec-au-moins-64-caracteres-aleatoires

# Configuration de l'API
API_BASE=https://votre-domaine.com

# Environnement
NODE_ENV=production

# Configuration de sécurité supplémentaire
# Limiter les tentatives de connexion
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT_MINUTES=15
LOGIN_BLOCK_DURATION_MINUTES=30

# Configuration des cookies sécurisés
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict
COOKIE_MAX_AGE=86400000

# Configuration de sécurité supplémentaire
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration des en-têtes de sécurité
ENABLE_SECURITY_HEADERS=true
ENABLE_CORS=false
CORS_ORIGIN=https://votre-domaine.com

# Configuration du logging de sécurité
ENABLE_SECURITY_LOGGING=true
LOG_LEVEL=warn 