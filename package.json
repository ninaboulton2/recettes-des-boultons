{
  "name": "boultons-recipes",
  "version": "1.0.0",
  "description": "Application de recettes des Boultons",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "postinstall": "nuxt prepare",
    "dev:local": "nuxt dev --dotenv .env.local --port 3001",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "vercel-build": "nuxt build",
    "typecheck": "nuxt typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local:up": "bash supabase/local/up.sh",
    "db:local:reset": "npx supabase db reset && bash supabase/local/setup.sh",
    "db:local:down": "npx supabase stop",
    "db:local:status": "npx supabase status",
    "db:local:test": "bash supabase/local/test.sh",
    "db:local:snapshot": "node supabase/local/build_snapshot.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/mistral": "^4.0.56",
    "@ai-sdk/openai": "^4.0.83",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/nuxt": "^11.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.127",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nuxt",
    "vue",
    "recipes",
    "cooking",
    "authentication",
    "security"
  ],
  "author": "Les Boultons",
  "license": "MIT"
}
