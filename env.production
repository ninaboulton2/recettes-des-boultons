# Configuration de production
NODE_ENV=production
API_BASE=https://recettes-des-boultons.vercel.app

# Configuration d'authentification (OBLIGATOIRE en production)
ADMIN_USERNAME=lesboultons
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_very_long_and_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# Configuration OpenAI (pour le traducteur IA)
OPENAI_API_KEY=your_openai_api_key_here
