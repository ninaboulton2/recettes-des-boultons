# Copiez ce fichier vers .env et remplissez les valeurs.
# Aucune de ces variables ne doit être commitée.

# --- Supabase (obligatoire) ---
# URL du projet et clé publique "anon". Le module @nuxtjs/supabase lit
# SUPABASE_URL / SUPABASE_KEY ; nuxt.config.ts mappe SUPABASE_ANON_KEY vers
# SUPABASE_KEY pour rester compatible avec la configuration Vercel existante.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- IA : traducteur de recettes (page /traducteur, admins) ---
# Fournisseur : openai | anthropic | google | mistral | mock
#   mock = aucun appel réseau, recette fixe (développement local, tests).
# Recommandation (docs/IA_MODELES.md, prix du 2026-10-03) : openai / gpt-4.1-mini.
# Alternative hébergée en UE : mistral / mistral-small-latest.
AI_PROVIDER=openai
# Modèle du fournisseur ; vide = défaut du fournisseur (gpt-4.1-mini, claude-haiku-4-5,
# gemini-2.5-flash, mistral-small-latest).
AI_MODEL=
# Appels IA max par utilisateur et par jour (admins compris). 0 = traducteur désactivé.
AI_DAILY_QUOTA=50
# Clé du fournisseur choisi (une seule est nécessaire).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# --- Sentry : suivi des erreurs (optionnel) ---
# DSN du projet Sentry (Settings → Projects → <projet> → Client Keys). VIDE = SDK
# totalement inactif (aucune requête). Lu au build ET à l'exécution (navigateur
# et serveur). SENTRY_DSN est accepté en repli.
NUXT_PUBLIC_SENTRY_DSN=
# Upload des sourcemaps au build : uniquement si SENTRY_AUTH_TOKEN est défini
# (Settings → Auth Tokens, scope « project:releases » / « org:read »). Sans
# jeton : build normal, aucune sourcemap publiée. Ne jamais commiter le jeton.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
