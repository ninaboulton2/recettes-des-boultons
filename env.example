# Copiez ce fichier vers .env et remplissez les valeurs.
# Aucune de ces variables ne doit être commitée.

# --- Supabase (obligatoire) ---
# URL du projet et clé publique "anon". Le module @nuxtjs/supabase lit
# SUPABASE_URL / SUPABASE_KEY ; nuxt.config.ts mappe SUPABASE_ANON_KEY vers
# SUPABASE_KEY pour rester compatible avec la configuration Vercel existante.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- OpenAI (optionnel : page /traducteur uniquement) ---
OPENAI_API_KEY=
