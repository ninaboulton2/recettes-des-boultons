# ============================================================================
#  Variables d'environnement — référence
# ============================================================================
#  Une entrée par variable lue par le code. Aucune valeur secrète ici.
#  - Développement : partir de .env.local.example (base Supabase LOCALE),
#    copié en .env.local, puis `npm run dev:local`.
#    Ne jamais créer de .env pointant sur la base de production.
#  - Production : Vercel → Settings → Environment Variables.
#  Détail : DEVELOPER.md, § 15.
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
# URL du projet. Lue au build (nuxt.config.ts : module Supabase et domaines
# autorisés de @nuxt/image) et par les tests e2e (refus si elle n'est pas locale).
SUPABASE_URL=https://your-project-ref.supabase.co
# Clé PUBLIQUE : publishable (sb_publishable_…) ou anon legacy. nuxt.config.ts
# la transmet au module @nuxtjs/supabase (qui attend SUPABASE_KEY).
# Jamais la clé secrète / service_role.
SUPABASE_ANON_KEY=

# --- Connexion OAuth --------------------------------------------------------
# Boutons affichés dans la fenêtre de connexion : google (défaut), google,apple,
# ou none pour n'afficher aucun bouton (e-mail + mot de passe seulement).
NUXT_PUBLIC_AUTH_PROVIDERS=google

# --- Traducteur IA (page /traducteur, admins) -------------------------------
# Fournisseur : openai | anthropic | google | mistral | mock
#   mock = aucun appel réseau, recette fixe (développement local, tests).
# Comparatif : docs/IA_MODELES.md.
AI_PROVIDER=openai
# Modèle ; vide = défaut du fournisseur (gpt-4.1-mini, claude-haiku-4-5,
# gemini-2.5-flash, mistral-small-latest).
AI_MODEL=
# Appels IA par personne et par jour (admins compris). 0 = traducteur désactivé.
AI_DAILY_QUOTA=50
# Clé du fournisseur choisi (une seule est nécessaire).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# --- Sentry : suivi des erreurs (optionnel) ---------------------------------
# DSN du projet (Settings → Projects → recettes-des-boultons → Client Keys).
# Vide = SDK inactif, aucune requête. Lu au build et à l'exécution.
NUXT_PUBLIC_SENTRY_DSN=
# Ancien nom, lu seulement si NUXT_PUBLIC_SENTRY_DSN est vide.
# SENTRY_DSN=
# Envoi des sourcemaps au build, uniquement si SENTRY_AUTH_TOKEN est défini
# (Settings → Auth Tokens). Jeton secret : jamais dans le dépôt.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nina-fy
SENTRY_PROJECT=recettes-des-boultons

# --- Fournies par Vercel : ne pas définir -----------------------------------
# VERCEL=1                 (exclut la base locale des domaines @nuxt/image)
# VERCEL_ENV=production    (environnement Sentry : production | preview)

# --- Build et tests (optionnel, en ligne de commande) -----------------------
# Build servi par Node au lieu de Vercel (tests e2e, essai de la PWA) :
# NITRO_PRESET=node-server
# Tests e2e (playwright.config.ts) : dev (défaut en local) | preview (défaut en CI)
# E2E_SERVER=dev
# E2E_BASE_URL=http://localhost:3042   # viser un serveur déjà lancé
# E2E_PORT=3042
# CI=true                              # positionnée par GitHub Actions
# Tests d'intégration (test/integration, test/unit/schemas/units.test.ts) :
# APP_URL=http://localhost:3001
# LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Outillage de la base locale (supabase/local, scripts/) -----------------
# Base visée par setup.sh / ci-seed.sh (refusée si l'hôte n'est pas local) :
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Base séparée pour npm run db:local:test (la base postgres n'est pas touchée) :
# SUPABASE_TEST_DATABASE=ci_test
# URL complète de cette base de test (défaut : déduite du nom ci-dessus) :
# SUPABASE_TEST_DB_URL=
# Commande de la CLI Supabase pour scripts/ci-env-local.sh :
# SUPABASE_CLI=npx supabase
# Tests SQL sans Docker (supabase/tests/run_local.sh) : binaires Postgres 17 et port
# PGBIN=/opt/homebrew/opt/postgresql@17/bin
# PGPORT_TEST=54329
