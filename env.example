# ============================================================================
#  Variables d'environnement — référence
# ============================================================================
#  Une entrée par variable lue par le code. Aucune valeur secrète ici.
#  - Développement : partir de .env.local.example (base Supabase LOCALE),
#    copié en .env.local, puis `npm run dev:local`.
#    Ne jamais créer de .env pointant sur la base de production.
#  - Production : Vercel → Settings → Environment Variables.
#  Détail : DEVELOPER.md, § 15.
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
# URL du projet. Lue au build (nuxt.config.ts : module Supabase et domaines
# autorisés de @nuxt/image) et par les tests e2e (refus si elle n'est pas locale).
SUPABASE_URL=https://your-project-ref.supabase.co
# Clé PUBLIQUE : publishable (sb_publishable_…) ou anon legacy. nuxt.config.ts
# la transmet au module @nuxtjs/supabase (qui attend SUPABASE_KEY).
# Jamais la clé secrète / service_role.
SUPABASE_ANON_KEY=

# Clé SECRÈTE (service_role / sb_secret_…), SERVEUR SEULEMENT : suppression de compte (server/api/account/delete.post.ts,
# auth.admin.deleteUser). Variable lue par @nuxtjs/supabase ; jamais dans le navigateur, jamais préfixée NUXT_PUBLIC_.
# Vide : la route répond 500 et le reste du site fonctionne.
SUPABASE_SECRET_KEY=

# --- Connexion OAuth --------------------------------------------------------
# Boutons affichés dans la fenêtre de connexion : google (défaut), google,apple,
# ou none pour n'afficher aucun bouton (e-mail + mot de passe seulement).
NUXT_PUBLIC_AUTH_PROVIDERS=google

# --- Édition du site ----------------------------------------------------------
# boultons (défaut) : identité d'origine (bleu-vert, illustrations, accueil d'origine)
# generic           : design modernisé, base de la future version multi-comptes
# Lue à l'exécution ; le manifeste PWA suit la valeur présente au build.
NUXT_PUBLIC_EDITION=boultons

# --- Traducteur IA (page /traducteur, admins) -------------------------------
# Fournisseur : openai | anthropic | google | mistral | mock
#   mock = aucun appel réseau, recette fixe (développement local, tests).
# Comparatif : docs/IA_MODELES.md.
AI_PROVIDER=openai
# Modèle ; vide = défaut du fournisseur (gpt-4.1-mini, claude-haiku-4-5,
# gemini-2.5-flash, mistral-small-latest).
AI_MODEL=
# Modèle de transcription de la dictée (OpenAI uniquement ; vide = gpt-4o-mini-transcribe).
AI_TRANSCRIBE_MODEL=
# Appels IA par personne et par jour (admins compris). 0 = traducteur désactivé.
AI_DAILY_QUOTA=50
# --- IA ouverte à tous (v2, NUXT_PUBLIC_V2=true ; DEVELOPER.md § 20.15) ---
# Appels IA par jour d'un compte NEUF (créé il y a moins de AI_NEW_ACCOUNT_DAYS jours). Les autres comptes : AI_DAILY_QUOTA.
# Un plafond personnel (colonne profiles.ai_daily_quota, posée par le support) l'emporte sur les deux.
AI_NEW_ACCOUNT_DAILY_QUOTA=20
AI_NEW_ACCOUNT_DAYS=30
# Budget du mois (calendrier de Paris), TOUS comptes confondus ; au-delà, l'IA est coupée pour tout le monde (même message
# que « crédit épuisé ») et Nina est prévenue une fois par 24 h. 0 = pas de budget. Appels (ok + erreurs) ou dollars estimés.
AI_MONTHLY_BUDGET_CALLS=0
AI_MONTHLY_BUDGET_USD=0

# Clé du fournisseur choisi (une seule est nécessaire).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# --- Import depuis Google Drive (traducteur IA, optionnel) ------------------
# Trois valeurs PUBLIQUES (aucun secret). Une seule vide = bouton Drive masqué.
# Pas à pas : docs/GOOGLE_DRIVE_SETUP.md.
# ID client OAuth « Application Web » (même projet Google Cloud que la connexion Google).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Clé d'API restreinte à Google Picker API et aux référents HTTP du site.
NUXT_PUBLIC_GOOGLE_API_KEY=
# Numéro du projet Google Cloud (chiffres uniquement).
NUXT_PUBLIC_GOOGLE_APP_ID=

# --- Sentry : suivi des erreurs (optionnel) ---------------------------------
# DSN du projet (Settings → Projects → recettes-des-boultons → Client Keys).
# Vide = SDK inactif, aucune requête. Lu au build et à l'exécution.
NUXT_PUBLIC_SENTRY_DSN=
# Ancien nom, lu seulement si NUXT_PUBLIC_SENTRY_DSN est vide.
# SENTRY_DSN=
# Envoi des sourcemaps au build, uniquement si SENTRY_AUTH_TOKEN est défini
# (Settings → Auth Tokens). Jeton secret : jamais dans le dépôt.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nina-fy
SENTRY_PROJECT=recettes-des-boultons

# --- Fournies par Vercel : ne pas définir -----------------------------------
# VERCEL=1                 (exclut la base locale des domaines @nuxt/image)
# VERCEL_ENV=production    (environnement Sentry : production | preview)

# --- Build et tests (optionnel, en ligne de commande) -----------------------
# Build servi par Node au lieu de Vercel (tests e2e, essai de la PWA) :
# NITRO_PRESET=node-server
# Tests e2e (playwright.config.ts) : dev (défaut en local) | preview (défaut en CI)
# E2E_SERVER=dev
# E2E_BASE_URL=http://localhost:3042   # viser un serveur déjà lancé
# E2E_PORT=3042
# CI=true                              # positionnée par GitHub Actions
# Tests d'intégration (test/integration, test/unit/schemas/units.test.ts) :
# APP_URL=http://localhost:3001
# LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Outillage de la base locale (supabase/local, scripts/) -----------------
# Base visée par setup.sh / ci-seed.sh (refusée si l'hôte n'est pas local) :
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Base séparée pour npm run db:local:test (la base postgres n'est pas touchée) :
# SUPABASE_TEST_DATABASE=ci_test
# URL complète de cette base de test (défaut : déduite du nom ci-dessus) :
# SUPABASE_TEST_DB_URL=
# Commande de la CLI Supabase pour scripts/ci-env-local.sh :
# SUPABASE_CLI=npx supabase
# Tests SQL sans Docker (supabase/tests/run_local.sh) : binaires Postgres 17 et port
# PGBIN=/opt/homebrew/opt/postgresql@17/bin
# PGPORT_TEST=54329

# --- E-mails transactionnels (Resend ; v2, phase 7 ; DEVELOPER.md § 20.15) ------------------------------------------
# TOUT VIDE = aucun e-mail envoyé, un journal côté serveur, aucune erreur pour l'utilisateur (le domaine n'est pas encore acheté).
# Clé d'API Resend (serveur seulement) et expéditeur sur un domaine VÉRIFIÉ dans Resend, ex. « Recettes <no-reply@mondomaine.com> ».
RESEND_API_KEY=
EMAIL_FROM=
# Adresse de Nina pour l'alerte « crédit IA épuisé » (au plus un e-mail par 24 h). Jamais écrite dans le code.
ALERT_EMAIL=
# Adresse publique du site (liens des e-mails). Vide = adresse de la requête.
SITE_URL=
# Nom du site dans les e-mails (défaut : Recettes).
EMAIL_APP_NAME=
# Secret des tâches planifiées Vercel (/api/cron/*), 16 caractères au moins, aléatoire. Vercel l'envoie en
# « Authorization: Bearer … ». Absent ou trop court : les routes cron répondent 503 (jamais ouvertes).
CRON_SECRET=
