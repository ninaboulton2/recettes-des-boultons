# Variables d'environnement — base Supabase LOCALE (npm run db:local:up)
# Copier vers .env.local (gitignoré) puis lancer `npm run dev:local`.
# Ces valeurs sont celles, fixes et publiques, de la CLI Supabase en local
# (`npx supabase status`) : elles ne donnent accès à rien en dehors de ta machine.

SUPABASE_URL=http://127.0.0.1:54321
# Clé anon locale (JWT de démo de la CLI, identique sur toutes les machines).
# Équivalent accepté : la clé publishable affichée par `npx supabase status` (sb_publishable_…).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Traducteur IA en local : fournisseur simulé (recette fixe, aucun appel payant).
# Pour tester avec le vrai modèle : AI_PROVIDER=openai et OPENAI_API_KEY=<votre clé>.
AI_PROVIDER=mock
# Les tests e2e et d'intégration consomment le quota IA du jour (50 par défaut) : le relever en local.
AI_DAILY_QUOTA=1000
OPENAI_API_KEY=

# Google n'est pas configuré dans la stack locale (supabase/config.toml) : bouton masqué.
NUXT_PUBLIC_AUTH_PROVIDERS=none

# Import Google Drive du traducteur : vide = bouton masqué (défaut local).
# Pour l'essayer : renseigner les trois valeurs (voir docs/GOOGLE_DRIVE_SETUP.md)
# et autoriser http://localhost:3001 dans le client OAuth.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_API_KEY=
NUXT_PUBLIC_GOOGLE_APP_ID=

# Sentry : laisser vide pour ne rien envoyer depuis le poste de dev
# (ou coller le DSN du projet pour tester la remontée d'erreurs, environment=development).
NUXT_PUBLIC_SENTRY_DSN=
